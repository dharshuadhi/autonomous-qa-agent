# Copy this file to .env locally (or export these as real environment
# variables) and fill in your own values. Never commit the real .env file --
# it's already in .gitignore.

# Anthropic Claude API key (console.anthropic.com) -- used for test
# generation (Step 7) and root cause analysis (Step 8).
LLM_API_KEY=

# Azure DevOps -- used for auto bug filing (Step 9).
ADO_ORG=your-org-name
ADO_PROJECT=your-project-name
ADO_PAT=

# Run Chrome headless (set to "true" in CI; leave unset to watch it run locally)
HEADLESS=
